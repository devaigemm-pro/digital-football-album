<?xml version="1.0" encoding="utf-8"?>
<!--
  Fallback del icono del launcher para Android < 8.0 (API < 26), donde no se
  usan los adaptive-icons de mipmap-anydpi-v26. Es un ÚNICO vector (authorable
  como texto, sin PNG raster) que combina el fondo verde y el balón blanco.
  Garantiza que `@mipmap/ic_launcher` resuelva en todas las densidades y
  versiones, de modo que el build no falle por iconos raster faltantes.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Fondo. -->
    <path
        android:fillColor="@color/ic_launcher_background"
        android:pathData="M0,0h108v108h-108z" />
    <!-- Balón (círculo blanco). -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,26 C69.46,26 82,38.54 82,54 C82,69.46 69.46,82 54,82 C38.54,82 26,69.46 26,54 C26,38.54 38.54,26 54,26 Z" />
    <!-- Parche central. -->
    <path
        android:fillColor="@color/ic_launcher_background"
        android:pathData="M54,42 L63.4,48.8 L59.8,59.9 L48.2,59.9 L44.6,48.8 Z" />
</vector>
