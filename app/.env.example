# Plantilla de configuración por entorno de la App_Móvil (react-native-config).
#
# Copia este archivo a `.env` (por defecto), `.env.development` y
# `.env.production` y rellena los valores reales. Los `.env*` con datos NO se
# versionan (ver `.gitignore`); solo este `.env.example` se versiona.
#
# El build nativo selecciona qué archivo cargar según la variante:
#   - Android: `project.ext.envConfigFiles` en `android/app/build.gradle`
#     (release/*Release -> .env.production, debug/*Debug -> .env.development).
#   - iOS: por esquema/xcconfig (ver README de react-native-config).

# Entorno lógico de la app: development | production (default: development).
APP_ENV=development

# URL base del backend. OBLIGATORIA y DEBE usar TLS (https://). Se valida en
# `src/config/env.ts` (Req 28.1). Sin barra final (se normaliza).
#   Backend en Supabase:  https://<PROYECTO>.supabase.co
#   (Supabase Dashboard > Project Settings > API > Project URL)
API_BASE_URL=https://api.example.com

# Client ID web de Google para @react-native-google-signin/google-signin
# (GoogleSignin.configure({ webClientId })). Necesario para el login con Google
# (Req 22.1). Déjalo vacío para deshabilitar el login con Google.
GOOGLE_WEB_CLIENT_ID=

# URL scheme inverso de iOS para el Sign-In de Google (del OAuth client de iOS
# en GoogleService-Info.plist). Solo aplica en iOS; déjalo vacío si no aplica.
IOS_URL_SCHEME=
