# Plantilla de configuración por entorno de la App_Móvil (react-native-config).
# Copia a .env / .env.development / .env.production y rellena. Solo .env.example se versiona.

APP_ENV=development

# Backend de negocio (API Gateway). https:// obligatorio. Rutas /me/*, /clubs, /album, /cards, /partidos.
API_BASE_URL=https://album-backend-xxxx.onrender.com

# Supabase Auth: la app autentica DIRECTAMENTE contra Supabase con supabase-js.
# SUPABASE_URL = Project URL; SUPABASE_ANON_KEY = clave PÚBLICA anon (NUNCA la service_role).
# (Supabase Dashboard > Project Settings > API)
SUPABASE_URL=https://<PROYECTO>.supabase.co
SUPABASE_ANON_KEY=

# Google Sign-In (opcional). Vacío = deshabilitado.
GOOGLE_WEB_CLIENT_ID=
# iOS reversed client id para Google Sign-In (solo iOS).
IOS_URL_SCHEME=
