{
  "name": "digital-football-album-app",
  "version": "0.1.0",
  "private": true,
  "description": "App_Móvil (cliente React Native + TypeScript) del Álbum de Fútbol Digital",
  "scripts": {
    "start": "react-native start",
    "ios": "react-native run-ios",
    "android": "react-native run-android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "jest",
    "test:watch": "jest --watch",
    "e2e:build:ios": "detox build --configuration ios.sim.debug",
    "e2e:test:ios": "detox test --configuration ios.sim.debug",
    "e2e:build:android": "detox build --configuration android.emu.debug",
    "e2e:test:android": "detox test --configuration android.emu.debug"
  },
  "dependencies": {
    "@invertase/react-native-apple-authentication": "2.4.0",
    "@notifee/react-native": "9.1.2",
    "@react-native-firebase/app": "20.5.0",
    "@react-native-firebase/messaging": "20.5.0",
    "@react-native-google-signin/google-signin": "13.1.0",
    "@react-navigation/native": "6.1.18",
    "@react-navigation/native-stack": "6.11.0",
    "@react-navigation/bottom-tabs": "6.6.1",
    "@tanstack/react-query": "5.59.20",
    "react": "18.3.1",
    "react-native": "0.75.4",
    "react-native-config": "1.5.3",
    "react-native-iap": "12.15.2",
    "react-native-image-picker": "7.1.2",
    "react-native-keychain": "8.2.0",
    "react-native-permissions": "4.1.5",
    "react-native-safe-area-context": "4.11.0",
    "react-native-screens": "3.34.0",
    "react-native-share": "10.2.1"
  },
  "devDependencies": {
    "@babel/core": "7.25.2",
    "@babel/preset-env": "7.25.4",
    "@babel/runtime": "7.25.6",
    "@react-native/babel-preset": "0.75.4",
    "@react-native/eslint-config": "0.75.4",
    "@react-native/metro-config": "0.75.4",
    "@react-native/typescript-config": "0.75.4",
    "@testing-library/react-native": "12.7.2",
    "@types/jest": "29.5.13",
    "@types/react": "18.3.3",
    "@types/react-test-renderer": "18.3.0",
    "detox": "20.27.4",
    "eslint": "8.57.1",
    "jest": "29.7.0",
    "react-test-renderer": "18.3.1",
    "typescript": "5.7.2"
  },
  "engines": {
    "node": ">=18"
  }
}
