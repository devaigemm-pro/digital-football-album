# Plantilla de variables de entorno del backend del Álbum de Fútbol Digital.
#
# Copia este archivo a `.env.local` (dev) y complétalo, o inyecta estas
# variables desde el gestor de secretos de tu plataforma en producción.
# NUNCA commitees valores reales: `.env` y `.env.*` están en .gitignore.
# La configuración se valida al arranque (fail-fast); ver src/composition/config.ts.

# --- General ---
NODE_ENV=development           # development | test | production
PORT=3000
HOST=0.0.0.0
# ALLOW_INSECURE=true          # Relaja TLS en el borde. Prohibido en producción.

# --- Persistencia ---
PERSISTENCE_DRIVER=memory      # memory (dev) | supabase (producción)
# Requeridas si PERSISTENCE_DRIVER=supabase:
# SUPABASE_URL=https://<proyecto>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<service_role_key>   # SECRETO — solo backend

# --- Autenticación ---
# Opción A (recomendada): delegar en Supabase Auth (verifica JWT contra JWKS).
# AUTH_PROVIDER=supabase
# SUPABASE_URL=https://<proyecto>.supabase.co
# SUPABASE_ANON_KEY=<anon_o_publishable_key>
# SUPABASE_JWT_SECRET=<legacy_hs256_opcional>    # Solo si usas tokens HS256 antiguos

# Opción B (fallback): JWT HMAC propio del AuthService.
# ACCESS_TOKEN_SECRET debe tener >= 32 caracteres en producción.
ACCESS_TOKEN_SECRET=cambia-esto-por-un-secreto-de-32+caracteres
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
